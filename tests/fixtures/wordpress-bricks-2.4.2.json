 "abilityInfo": {
  "bricks/get-mcp-version": {
   "name": "bricks/get-mcp-version",
   "label": "Bricks-MCP-Version abrufen",
   "description": "Meldet die Bricks-Plugin-Version, die Vertragsversion der Bricks-Fähigkeiten, die Version des WordPress MCP Adapter und die WordPress-Core-Version. Einmal zu Sitzungsbeginn aufrufen, um Versionsabweichungen während der Unterhaltung zu erkennen. `disabledAbilityCount` umfasst sowohl vom Administrator deaktivierte als auch standardmäßig ausgeschaltete Fähigkeiten; `adminDisabledAbilityCount` und `defaultDisabledAbilityCount` unterscheiden diese Zustände.",
   "input_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false,
    "default": {}
   },
   "output_schema": {
    "type": "object",
    "properties": {
     "bricksVersion": {
      "type": "string",
      "description": "Version des aktiven Bricks-Plugins."
     },
     "bricksAbilitiesVersion": {
      "type": "string",
      "description": "Version des Bricks-Ability-Vertrags. Wird bei inkompatiblen Änderungen an Ability-Signaturen, Fehlercodes oder Antwortstrukturen erhöht."
     },
     "adapterVersion": {
      "type": [
       "string",
       "null"
      ],
      "description": "Version des WordPress-Plugins mcp-adapter oder null, wenn es nicht erkannt wurde."
     },
     "wordpressVersion": {
      "type": "string",
      "description": "WordPress-Core-Version."
     },
     "abilitiesApiActive": {
      "type": "boolean",
      "description": "Gibt an, ob wp_register_ability verfügbar ist."
     },
     "disabledAbilityCount": {
      "type": "integer",
      "description": "Gesamtzahl der derzeit deaktivierten Abilities, einschließlich vom Administrator deaktivierter Abilities und standardmäßig deaktivierter Kategorien. Rufen Sie `bricks-list-ability-status` auf, um die betroffenen Abilities anzuzeigen."
     },
     "adminDisabledAbilityCount": {
      "type": "integer",
      "description": "Anzahl der Abilities, die der Administrator unter Bricks > Einstellungen > AI ausdrücklich deaktiviert hat."
     },
     "defaultDisabledAbilityCount": {
      "type": "integer",
      "description": "Anzahl der deaktivierten Abilities, deren Kategorie standardmäßig deaktiviert und nicht ausdrücklich aktiviert wurde."
     }
