  "bricks/get-design-context": {
   "name": "bricks/get-design-context",
   "label": "Designkontext abrufen",
   "description": "Zusammenfassung des Designkontexts der Website in einem Aufruf: Farbpaletten, globale Klassen, Theme-Stile, Komponenten, globale Variablen und responsive Breakpoints. Für eine begrenzte Orientierungsübersicht `responseFormat: \"summary\"` oder `includeUsage: true` übergeben, um jeder Komponente `usedOnPosts` hinzuzufügen.",
   "input_schema": {
    "type": "object",
    "properties": {
     "includeUsage": {
      "type": "boolean",
      "description": "`usedOnPosts` für jede Komponente einbeziehen, beschränkt auf Beiträge, die der Aufrufer im Builder bearbeiten kann. Standardmäßig deaktiviert: Die erste Berechnung durchsucht alle Bricks-Beiträge und kann auf großen Websites einige Sekunden dauern. Die Nutzungsdaten werden eine Stunde lang zwischengespeichert und bei jedem Abruf für den aktuellen Aufrufer gefiltert."
     },
     "responseFormat": {
      "type": "string",
      "enum": [
       "detailed",
       "summary"
      ],
      "description": "Verwende `summary` zur Orientierung in der Sitzung: Enthält Anzahlen, Breakpoints und begrenzte Ressourcenlisten. Der Standardwert `detailed` behält die vollständige aktuelle Antwort bei."
     },
     "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "description": "Maximale Anzahl von Einträgen pro großer Liste, wenn `responseFormat` auf `summary` gesetzt ist. Standard: 100."
     }
    },
    "additionalProperties": false,
    "default": {}
   },
   "output_schema": {
    "type": "object",
    "properties": {
     "counts": {
      "type": "object"
     },
     "colorPalettes": {
      "type": "array"
     },
     "globalClasses": {
      "type": "array"
     },
     "themeStyles": {
      "type": "array"
     },
     "components": {
      "type": "array"
     },
     "globalVariables": {
      "type": "array"
     },
     "variableCategories": {
      "type": "array",
      "description": "Kategorien globaler Variablen einschließlich der von generate-scale-variables verwendeten Skalierungskonfigurationen."
     },
     "breakpoints": {
      "type": "object",
      "description": "Aktuelle Schnittstellendefinition für responsive Breakpoints: customEnabled, isMobileFirst, baseKey, baseWidth und aktive Breakpoint-Einträge."
     },
     "truncated": {
      "type": "object",
      "description": "In Zusammenfassungsantworten vorhanden, wenn große Listen begrenzt wurden."
     },
     "version": {
      "type": "integer",
      "description": "Veralteter Designzähler der aktuellen Website. Verwende in Multisite-Konfigurationen mit gemischten Zuständigkeiten stattdessen designSystemSnapshot und die ressourcenspezifischen Versionen."
     },
     "designSystemSnapshot": {
      "type": "object",
      "description": "Design-Snapshot mit korrekter Zuständigkeit. Verwende seine Ressourcenversion für gezielte Schreibvorgänge und sein Token, um Abweichungen im Arbeitsbereich zu prüfen.",
      "properties": {
       "token": {
        "type": "string"
       },
       "authorities": {
        "type": "array"
       },
       "resources": {
        "type": "object"
       }
      },
      "required": [
       "token",
       "authorities",
       "resources"
      ],
      "additionalProperties": false
     },
     "usageCached": {
      "type": "boolean",
      "description": "True, wenn die Komponentennutzung aus dem Transient bereitgestellt wurde. Nicht vorhanden, wenn `includeUsage` nicht angefordert wurde."
     }
    }
   },
