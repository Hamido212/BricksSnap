  "bricks/list-ability-status": {
   "name": "bricks/list-ability-status",
   "label": "Status der Bricks-Fähigkeiten auflisten",
   "description": "Prüft, ob die erwarteten Bricks-Fähigkeiten aktiviert sind. Übergib für gezielte Diagnosen exakte `abilityNames`. Die Standardübersicht listet nur aktivierte Fähigkeiten auf; übergib `includeDisabled: true` für das vollständige kompakte Register oder verwende `detailed` für vollständige Metadaten. Abfragen nach exaktem Namen geben auch passende deaktivierte Fähigkeiten zurück.",
   "input_schema": {
    "type": "object",
    "properties": {
     "abilityNames": {
      "type": "array",
      "description": "Optionale exakte Ability-Namen zur Prüfung, beispielsweise `bricks/update-element`. Diagnosen anhand exakter Namen geben passende deaktivierte Abilities zurück, ohne includeDisabled zu erfordern.",
      "items": {
       "type": "string"
      },
      "maxItems": 50
     },
     "includeDisabled": {
      "type": "boolean",
      "default": false,
      "description": "Bezieht deaktivierte Zeilen in eine ungefilterte Zusammenfassung ein. Lassen Sie die Option weg, um eine kompakte Übersicht der aktivierten Abilities zu erhalten. Detaillierte Antworten enthalten weiterhin die vollständige Registry."
     },
     "responseFormat": {
      "type": "string",
      "enum": [
       "summary",
       "detailed"
      ],
      "default": "summary",
      "description": "Die Zusammenfassung gibt kompakte Statuszeilen und standardmäßig nur aktivierte Abilities zurück. Die detaillierte Ansicht enthält Bezeichnungen, Beschreibungen, Annotationen und die vollständige Registry."
     }
    },
    "additionalProperties": false,
    "default": {}
   },
   "output_schema": {
    "type": "object",
    "properties": {
     "abilities": {
      "type": "array",
      "description": "Angeforderte Statuszeilen für Bricks-Abilities. Eine ungefilterte Zusammenfassung gibt standardmäßig aktivierte Abilities zurück; übergeben Sie includeDisabled, um die vollständige Registry einzubeziehen."
     },
     "responseFormat": {
      "type": "string"
     },
     "returned": {
      "type": "integer"
     },
     "total": {
      "type": "integer"
     },
     "enabled": {
      "type": "integer"
     },
     "disabled": {
      "type": "integer"
     }
    }
   },
   "meta": {
    "annotations": {
     "readonly": true,
     "destructive": false,
     "idempotent": null
    },
    "mcp": {
     "public": true,
     "annotations": {
      "readonly": true,
      "destructive": false
     }
    },
    "show_in_rest": true,
    "public": false
   }
  },
  "bricks/find-post": {
   "name": "bricks/find-post",
   "label": "Beitrag suchen",
   "description": "Beiträge, Seiten und Templates nach Slug, Titel oder Freitextfragment durchsuchen. Gibt nur Datensätze zurück, die der aktuelle Benutzer bearbeiten kann, ergänzt um Bricks-Metadaten (`bricksEnabled`, `hasBricksData`, `locked`, `builderUrl`).",
   "input_schema": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "description": "Slug-/Titelfragment für die Textsuche. Weglassen, um die zuletzt geänderten Beiträge aufzulisten. Schließt sich gegenseitig mit postId/slug/path aus."
     },
     "postId": {
      "type": "integer",
      "description": "Direkte Suche anhand der Beitrags-ID. Gibt eine Liste mit einem einzelnen Ergebnis zurück. Schließt sich gegenseitig mit query/slug/path aus."
     },
     "slug": {
      "type": "string",
      "description": "Direkte Suche anhand des exakten post_name. Gibt Beiträge zurück, deren Slug in den zulässigen Beitragstypen übereinstimmt. Schließt sich gegenseitig mit query/postId/path aus."
     },
     "path": {
      "type": "string",
      "description": "Direkte Suche anhand des hierarchischen Pfads (z. B. \"parent/child\"). Schließt sich gegenseitig mit query/postId/slug aus."
     },
     "postType": {
      "type": "string",
      "description": "Auf einen einzelnen Beitragstyp beschränken. Weglassen, um alle bearbeitbaren Typen zu durchsuchen."
     },
     "status": {
      "type": "string",
      "description": "draft | publish | pending | private | future | any. Standard: any."
     },
     "bricksOnly": {
      "type": "boolean",
      "description": "Auf für Bricks aktivierte Beitragstypen und das Template-CPT beschränken. Standard: false (damit Nicht-Bricks-Beiträge mit bricksEnabled: false ausgegeben werden)."
     },
     "limit": {
      "type": "integer",
      "description": "Maximale Anzahl Ergebnisse: 1..50. Standard: 10."
     },
     "orderBy": {
      "type": "string",
      "description": "modified | title | relevance. Standard: modified."
     }
    },
    "additionalProperties": false,
    "default": {}
   },
   "output_schema": {
    "type": "object",
    "properties": {
     "results": {
      "type": "array",
      "description": "Übereinstimmende Beiträge mit Bearbeitungs-/Builder-URLs und Bricks-Metadaten."
     },
     "total": {
      "type": "integer"
     }
    }
   },
   "meta": {
    "annotations": {
     "readonly": true,
     "destructive": false,
     "idempotent": null
    },
    "mcp": {
     "public": true,
     "annotations": {
      "readonly": true,
      "destructive": false
     }
    },
    "show_in_rest": true,
    "public": false
   }
  },
  "bricks/get-page-elements": {
   "name": "bricks/get-page-elements",
   "label": "Seitenelemente abrufen",
   "description": "Vollständige Elementdaten einer Seite/eines Templates mit allen Einstellungen. Optional nach einem bestimmten Element und seinen Kindelementen filtern.",
   "input_schema": {
    "type": "object",
    "properties": {
     "postId": {
      "type": "integer",
      "description": "Beitrags-, Seiten- oder Template-ID. Die primäre Kennung; verwende sie bevorzugt, wenn sie bekannt ist."
     },
     "slug": {
      "type": "string",
      "description": "Beitrags-Slug. Alternative zu postId."
     },
     "path": {
      "type": "string",
      "description": "Hierarchischer Pfad wie \"parent/child\". Alternative zu postId für verschachtelte Seiten."
     },
     "title": {
      "type": "string",
      "description": "Exakter Beitragstitel. Alternative zu `postId`; mehrdeutig, wenn mehrere Beiträge denselben Titel haben."
     },
     "elementId": {
      "type": "string",
      "description": "Optional: Nur dieses Element und seine untergeordneten Elemente zurückgeben."
     },
     "maxDepth": {
      "type": "integer",
      "minimum": 0,
      "description": "Optionale Tiefe der einzubeziehenden Nachfahren. 0 gibt nur das Wurzelelement bzw. die Wurzelelemente zurück, 1 schließt direkte Kindelemente ein usw."
     },
     "includeSettings": {
      "type": "boolean",
      "description": "Gibt an, ob die vollständigen Einstellungen der zurückgegebenen Elemente enthalten sein sollen. Standardmäßig true."
     },
     "responseFormat": {
      "type": "string",
      "enum": [
       "detailed",
       "summary"
      ],
      "description": "Verwende `summary` nach umfangreichen Schreibvorgängen, um Elementanzahl, Hierarchie, Überschriften, Verweise auf globale Klassen und die Vorgaben für Fallback-Größen von SVG-Bildern zu prüfen, ohne die vollständigen Einstellungsdaten zurückzugeben. Der Standardwert `detailed` behält die vollständige Elementantwort bei."
     },
     "returnFields": {
      "type": "array",
      "description": "Optionale Liste der zurückzugebenden Elementfelder. `id` ist immer enthalten. Standardmäßig werden alle Felder zurückgegeben.",
      "items": {
       "type": "string",
       "enum": [
        "id",
        "name",
        "parent",
        "label",
        "settings",
        "children",
        "cid",
        "properties",
        "variant",
        "slotChildren",
        "selectors"
       ]
      }
     }
    },
    "additionalProperties": false,
    "default": {}
   },
   "output_schema": {
    "type": "object",
    "properties": {
     "elements": {
      "type": "array"
     },
     "summary": {
      "type": "object",
      "description": "Kompakte Prüfung von Struktur und Verweisintegrität, wenn responseFormat den Wert summary hat."
     },
     "postId": {
      "type": "integer"
     },
     "documentDigest": {
      "type": "string",
      "description": "SHA-256-Digest des vollständigen aktuellen Bricks-Elementbaums. Verwende ihn als expectedDocumentDigest für Schreibvorgänge mit optimistischer Nebenläufigkeitskontrolle und für Importvorschauen."
     }
    }
   },
   "meta": {
    "annotations": {
     "readonly": true,
     "destructive": false,
     "idempotent": null
    },
    "mcp": {
     "public": true,
     "annotations": {
      "readonly": true,
      "destructive": false
     }
    },
    "show_in_rest": true,
    "public": false
   }
  },
